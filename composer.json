{
    "name": "fopost/symfony-bundle",
    "description": "Official Symfony bundle for the FoPost API. Schedule and publish to +30 social platforms from your code.",
    "type": "symfony-bundle",
    "keywords": ["fopost", "symfony", "symfony-bundle", "social-media", "scheduling", "publishing", "api", "sdk"],
    "homepage": "https://fopost.com",
    "license": "MIT",
    "authors": [
        {
            "name": "FoPost",
            "homepage": "https://fopost.com"
        },
        {
            "name": "Porter Bridge, LLC",
            "homepage": "https://fopost.com"
        }
    ],
    "support": {
        "docs": "https://fopost.com/docs",
        "issues": "https://github.com/fopost/fopost-symfony/issues",
        "source": "https://github.com/fopost/fopost-symfony"
    },
    "require": {
        "php": ">=8.1",
        "fopost/sdk": "^0.1",
        "symfony/config": "^6.4|^7.0",
        "symfony/console": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/event-dispatcher": "^6.4|^7.0",
        "symfony/framework-bundle": "^6.4|^7.0",
        "symfony/http-foundation": "^6.4|^7.0",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/routing": "^6.4|^7.0",
        "symfony/yaml": "^6.4|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Fopost\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fopost\\Symfony\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
